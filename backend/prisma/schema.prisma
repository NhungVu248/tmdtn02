generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  HOMESTAY
  TOUR
}

enum ProductStatus {
  VISIBLE
  HIDDEN
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String? // null với tài khoản đăng nhập bằng Google (không có mật khẩu)
  name          String?
  phone         String? // UC-07: số điện thoại
  address       String? // UC-07: thông tin liên hệ/địa chỉ
  avatar        String? // ảnh đại diện từ Google (nếu có)
  googleId      String?  @unique // liên kết tài khoản Google (UC-05 1a / UC-06 1b)
  emailVerified Boolean  @default(false) // BR-15: kích hoạt sau khi xác thực email
  acceptedTerms Boolean  @default(false) // BR-14: đồng ý điều khoản & chính sách
  failedLoginAttempts Int      @default(0) // BR-16: đếm lần đăng nhập sai liên tiếp
  lockedUntil         DateTime? // BR-16/2b: thời điểm hết tạm khóa
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

// Token đặt lại mật khẩu (UC-06 1a). Băm token, có hạn, dùng một lần.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Nhật ký đăng nhập (BR-16: ghi vết).
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
}

// Token xác thực email (UC-05). Băm token, có hạn dùng, hỗ trợ gửi lại.
model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Danh mục nhiều cấp (tự tham chiếu). BR-02: số cấp do quản trị viên cấu hình.
model Category {
  id        Int         @id @default(autoincrement())
  name      String
  slug      String      @unique
  type      ProductType
  order     Int         @default(0)
  parentId  Int?
  parent    Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]  @relation("CategoryTree")
  products  Product[]
  createdAt DateTime    @default(now())

  @@index([parentId])
  @@index([type])
}

// Sản phẩm: homestay hoặc tour.
model Product {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  type        ProductType
  status      ProductStatus @default(VISIBLE)
  description String?       @db.Text
  location    String? // tỉnh/thành hoặc vùng miền
  price       Int // giá cơ bản (đồng): homestay/đêm, tour/khách
  rating      Float         @default(0)
  thumbnail   String?
  isFeatured  Boolean       @default(false)
  amenities   String? // tiện nghi homestay, phân tách bằng dấu phẩy
  durationDays Int? // thời lượng tour (số ngày)
  priceChild  Int? // giá trẻ em cho tour (BR-09)
  cancellationPolicy String? @db.Text // chính sách hủy
  itinerary   String?       @db.Text // lịch trình tour
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  reviews        Review[]
  availabilities HomestayAvailability[]
  departures     TourDeparture[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
}

// Thư viện ảnh của sản phẩm (UC-03).
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([productId])
}

// Đánh giá của khách. BR-08: chỉ hiển thị đánh giá đã được duyệt.
model Review {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String?  @db.Text
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([approved])
}

// Lịch tồn phòng homestay theo đêm (BR-07).
model HomestayAvailability {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  totalRooms  Int
  bookedRooms Int      @default(0)

  @@unique([productId, date])
  @@index([productId])
}

// Chuyến khởi hành của tour (BR-07).
model TourDeparture {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  totalSeats  Int
  bookedSeats Int      @default(0)

  @@index([productId])
}

// Khu vực du lịch phổ biến hiển thị ở trang chủ.
model Area {
  id    Int     @id @default(autoincrement())
  name  String
  slug  String  @unique
  image String?
  order Int     @default(0)
}

// UC-04 – Trang thông tin & chính sách công khai, và bài viết cẩm nang.
enum InfoCategory {
  ABOUT // thông tin người bán / giới thiệu
  POLICY // các chính sách (BR-10)
  GUIDE // cẩm nang du lịch
}

model InfoArticle {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  title     String
  category  InfoCategory
  excerpt   String?
  content   String       @db.Text
  published Boolean      @default(true) // BR-11: admin công bố/ẩn
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([category])
  @@index([published])
}

// Chương trình khuyến mại đang chạy ở trang chủ.
model Promotion {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  image       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active])
}
