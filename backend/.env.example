# MySQL local (ví dụ XAMPP). Cấu hình mặc định dự án: user root, mật khẩu 123456, port 3306.
# Nếu root không mật khẩu: mysql://root:@localhost:3306/tmdt
DATABASE_URL="mysql://root:123456@localhost:3306/tmdt"

# Đổi thành một chuỗi ngẫu nhiên, dài, giữ bí mật
JWT_SECRET="change_this_to_a_random_secret"
JWT_EXPIRES_IN="7d"

PORT=4000
CLIENT_URL="http://localhost:5173"

# Gửi email xác thực (UC-05). Bỏ trống -> chế độ dev: link xác thực được log ra
# console và trả về trong response (devVerifyUrl). Điền SMTP để gửi email thật.
# NODE_ENV=production   # đặt để KHÔNG trả devVerifyUrl
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="you@gmail.com"
# SMTP_PASS="app_password"
# MAIL_FROM="StayTour <no-reply@staytour.example>"

# Đăng nhập/đăng ký bằng Google (UC-05 1a / UC-06 1b).
# Chỉ cần Client ID (Web) từ Google Cloud Console; KHÔNG cần client secret.
# GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
