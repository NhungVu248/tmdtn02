# MySQL local (ví dụ XAMPP). Cấu hình mặc định dự án: user root, mật khẩu 123456, port 3306.
# Nếu root không mật khẩu: mysql://root:@localhost:3306/tmdt
DATABASE_URL="mysql://root:123456@localhost:3306/tmdt"

# Đổi thành một chuỗi ngẫu nhiên, dài, giữ bí mật
JWT_SECRET="change_this_to_a_random_secret"
JWT_EXPIRES_IN="7d"

PORT=4000
CLIENT_URL="http://localhost:5173"
